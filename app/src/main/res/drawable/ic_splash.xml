<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch screen icon (Android 12+): the app icon itself, board and queen, so the queen has
    the same proportions as on the home screen. With an icon background set, the system
    shows it in a 160 dp circle, the same middle part a launcher shows.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
