<?xml version="1.0" encoding="utf-8"?>
<!-- Original globe glyph for the Gaia badge (Gaia, the Earth): the engine's own icon is built
     from a third-party piece set used with its artist's permission, not ours to redistribute. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Outline of the globe. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.6"
        android:pathData="M12,3.5 a8.5,8.5 0 1 0 0,17 a8.5,8.5 0 1 0 0,-17 Z" />
    <!-- Central meridian (an ellipse) and the axis. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.3"
        android:pathData="M12,3.5 C8.2,6.2 8.2,17.8 12,20.5 C15.8,17.8 15.8,6.2 12,3.5 Z" />
    <!-- Equator and two parallels. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.3" android:strokeLineCap="round"
        android:pathData="M3.5,12 H20.5 M5.2,7.6 H18.8 M5.2,16.4 H18.8" />
</vector>
