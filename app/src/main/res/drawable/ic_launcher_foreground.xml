<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon foreground (108 x 108 dp): the chess queen and the draughts king (a crowned
    stack) side by side. Launchers mask adaptive icons to shapes that always keep the 66 dp
    circle in the middle (radius 33 dp around 54,54). The piece drawings fill ~73 % of their
    box, so 40 dp boxes give ~29 dp pieces whose outer corners stay inside that circle
    (29.5 dp wide pair, half as tall: sqrt(29.5² + 14.75²) = 33 dp).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/piece_lq"
        android:left="19dp"
        android:top="33dp"
        android:right="49dp"
        android:bottom="35dp" />
    <item
        android:drawable="@drawable/stone_d2"
        android:left="49dp"
        android:top="34dp"
        android:right="19dp"
        android:bottom="34dp" />
</layer-list>
