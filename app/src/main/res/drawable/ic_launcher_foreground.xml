<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon foreground (108 x 108 dp): the chess queen, alone and large. Launchers show
    about the middle 72 dp and keep at least the 66 dp circle (radius 33 around 54,54). The
    queen drawing fills ~70 % of its box, so a 68 dp box makes it ~48 dp tall with the crown
    tips and the base still inside that circle; the box sits 2 dp high because the drawing
    is slightly bottom-heavy.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/piece_lq"
        android:left="20dp"
        android:top="18dp"
        android:right="20dp"
        android:bottom="22dp" />
</layer-list>
